{
  "name": "@mail-ai/extension",
  "displayName": "Mail AI - Smart Email Assistant",
  "version": "1.0.0",
  "description": "AI-powered email assistant for Gmail and Outlook",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.9.0",
    "@plasmohq/messaging": "^0.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/chrome": "^0.0.254",
    "autoprefixer": "^10.4.16",
    "plasmo": "^0.84.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0"
  },
  "manifest": {
    "permissions": [
      "storage",
      "activeTab"
    ],
    "host_permissions": [
      "https://mail.google.com/*",
      "https://outlook.live.com/*",
      "https://outlook.office.com/*"
    ]
  }
}

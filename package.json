{
  "name": "mail-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered email assistant for Gmail and Outlook",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:extension": "pnpm --filter @mail-ai/extension dev",
    "dev:server": "pnpm --filter @mail-ai/server dev",
    "build:extension": "pnpm --filter @mail-ai/extension build",
    "build:server": "pnpm --filter @mail-ai/server build"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "eslint": "^8.55.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
